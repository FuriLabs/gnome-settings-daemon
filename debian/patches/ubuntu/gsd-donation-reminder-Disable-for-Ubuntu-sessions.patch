From: Daniel van Vugt <daniel.van.vugt@canonical.com>
Date: Thu, 7 Aug 2025 13:33:02 +0800
Subject: gsd-donation-reminder: Disable for Ubuntu sessions

---
 plugins/housekeeping/gsd-donation-reminder.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/plugins/housekeeping/gsd-donation-reminder.c b/plugins/housekeeping/gsd-donation-reminder.c
index 4826607..47b6573 100644
--- a/plugins/housekeeping/gsd-donation-reminder.c
+++ b/plugins/housekeeping/gsd-donation-reminder.c
@@ -127,6 +127,10 @@ void
 gsd_donation_reminder_init (void)
 {
 	g_autoptr (GSettings) settings = NULL;
+	const char *xdg_current_desktop = g_getenv ("XDG_CURRENT_DESKTOP");
+
+	if (xdg_current_desktop && strstr (xdg_current_desktop, "ubuntu"))
+		return;
 
 	settings = g_settings_new (DONATE_SCHEMA);
 
